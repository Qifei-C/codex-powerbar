+/// Render precomputed footer lines (for multi-line custom status output).
+///
+/// The first row of `area` is left blank as a visual separator from the
+/// input box above; the HUD content renders starting from the second row.
+pub(crate) fn render_footer_lines(area: Rect, buf: &mut Buffer, lines: Vec<Line<'static>>) {
+    let clear_lines: Vec<Line<'_>> =
+        vec![Line::from(" ".repeat(area.width as usize)); area.height as usize];
+    Paragraph::new(clear_lines).render(area, buf);
+    // Skip the first row (blank separator) and render content below it.
+    if area.height > 1 {
+        let content_area = Rect {
+            x: area.x,
+            y: area.y + 1,
+            width: area.width,
+            height: area.height.saturating_sub(1),
+        };
+        Paragraph::new(prefix_lines(
+            lines,
+            " ".repeat(FOOTER_INDENT_COLS).into(),
+            " ".repeat(FOOTER_INDENT_COLS).into(),
+        ))
+        .render(content_area, buf);
+    }
+}
