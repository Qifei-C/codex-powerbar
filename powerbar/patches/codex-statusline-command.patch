+fn persist_powerbar_show_details(show_details: bool) -> std::result::Result<(), String> {
+    let home = dirs::home_dir().ok_or_else(|| "home directory is not available".to_string())?;
+    let config_dir = home.join(".powerbar");
+    let config_path = config_dir.join("config.json");
+
+    std::fs::create_dir_all(&config_dir)
+        .map_err(|err| format!("failed to create {}: {err}", config_dir.display()))?;
+
+    let mut value = if config_path.exists() {
+        let raw = std::fs::read_to_string(&config_path)
+            .map_err(|err| format!("failed to read {}: {err}", config_path.display()))?;
+        serde_json::from_str::<serde_json::Value>(&raw)
+            .map_err(|err| format!("failed to parse {}: {err}", config_path.display()))?
+    } else {
+        serde_json::json!({})
+    };
+
+    let object = value
+        .as_object_mut()
+        .ok_or_else(|| format!("{} does not contain a JSON object", config_path.display()))?;
+    object.insert("showDetails".to_string(), serde_json::Value::Bool(show_details));
+
+    let encoded = serde_json::to_string_pretty(&value)
+        .map_err(|err| format!("failed to encode {}: {err}", config_path.display()))?;
+    std::fs::write(&config_path, format!("{encoded}\n"))
+        .map_err(|err| format!("failed to write {}: {err}", config_path.display()))?;
+
+    Ok(())
+}
